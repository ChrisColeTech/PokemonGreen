				</technique_common>
			</source>
			<source id="anim_RToe_transform_interpolation">
				<Name_array id="anim_RToe_transform_interpolation_array" count="21">LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR</Name_array>
				<technique_common>
