	<library_effects>
		<effect id="eff_jf_shiro11_id" name="eff_jf_shiro11">
			<profile_COMMON>
				<newparam sid="img_surface_jf_shiro11">
					<surface type="2D">
						<init_from>jf_shiro11.tga_id</init_from>
						<format>PNG</format>
					</surface>
				</newparam>
				<newparam sid="img_sampler_jf_shiro11">
					<sampler2D>
						<source>img_surface_jf_shiro11</source>
						<wrap_s>WRAP</wrap_s>
						<wrap_t>WRAP</wrap_t>
						<minfilter>LINEAR_MIPMAP_LINEAR</minfilter>
						<magfilter>LINEAR</magfilter>
						<mipfilter>LINEAR</mipfilter>
					</sampler2D>
				</newparam>
				<technique sid="img_technique">
					<phong>
						<emission>
							<color>0 0 0 1</color>
						</emission>
						<ambient>
							<color>0 0 0 1</color>
						</ambient>
						<diffuse>
							<texture texture="img_sampler_jf_shiro11" texcoord="uv" />
						</diffuse>
						<specular>
							<color>1 1 1 1</color>
						</specular>
					</phong>
				</technique>
			</profile_COMMON>
		</effect>
