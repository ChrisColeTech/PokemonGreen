	<library_effects>
		<effect id="eff_land01_plant_shadow_id" name="eff_land01_plant_shadow">
			<profile_COMMON>
				<newparam sid="img_surface_land01_plant_shadow">
					<surface type="2D">
						<init_from>land01_plant_shadow.tga_id</init_from>
						<format>PNG</format>
					</surface>
				</newparam>
				<newparam sid="img_sampler_land01_plant_shadow">
					<sampler2D>
						<source>img_surface_land01_plant_shadow</source>
						<wrap_s>WRAP</wrap_s>
						<wrap_t>WRAP</wrap_t>
						<minfilter>LINEAR_MIPMAP_LINEAR</minfilter>
						<magfilter>LINEAR</magfilter>
						<mipfilter>LINEAR</mipfilter>
					</sampler2D>
				</newparam>
				<technique sid="img_technique">
					<phong>
						<emission>
							<color>0 0 0 1</color>
						</emission>
						<ambient>
							<color>0 0 0 1</color>
						</ambient>
						<diffuse>
							<texture texture="img_sampler_land01_plant_shadow" texcoord="uv" />
						</diffuse>
						<specular>
							<color>1 1 1 1</color>
						</specular>
					</phong>
				</technique>
			</profile_COMMON>
		</effect>
