				</technique_common>
			</source>
			<sampler id="anim_RToe_transform_sampler">
				<input semantic="INPUT" source="#anim_RToe_transform_input" />
				<input semantic="OUTPUT" source="#anim_RToe_transform_output" />
				<input semantic="INTERPOLATION" source="#anim_RToe_transform_interpolation" />
			</sampler>
			<channel source="#anim_RToe_transform_sampler" target="RToe_bone_id/transform" />
		</animation>
	</library_animations>
	<scene>
		<instance_visual_scene url="#vs_model_id" />
	</scene>
</COLLADA>