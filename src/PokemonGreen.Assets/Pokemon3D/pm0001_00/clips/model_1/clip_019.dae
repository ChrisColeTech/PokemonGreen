			<sampler id="anim_RFoot_transform_sampler">
				<input semantic="INPUT" source="#anim_RFoot_transform_input"/>
				<input semantic="OUTPUT" source="#anim_RFoot_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_RFoot_transform_interpolation"/>
			</sampler>
			<channel source="#anim_RFoot_transform_sampler" target="RFoot_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>