	<library_effects>
		<effect id="eff_Eye_id" name="eff_Eye">
			<profile_COMMON>
				<newparam sid="img_surface">
					<surface type="2D">
						<init_from>pm0324_00_Eye1.tga_id</init_from>
						<format>PNG</format>
					</surface>
				</newparam>
				<newparam sid="img_sampler">
					<sampler2D>
						<source>img_surface</source>
						<wrap_s>MIRROR</wrap_s>
						<wrap_t>WRAP</wrap_t>
						<minfilter>LINEAR_MIPMAP_LINEAR</minfilter>
						<magfilter>LINEAR</magfilter>
						<mipfilter>LINEAR</mipfilter>
					</sampler2D>
				</newparam>
				<technique sid="img_technique">
					<phong>
						<emission>
							<color>0 0 0 1</color>
						</emission>
						<ambient>
							<color>0 0 0 1</color>
						</ambient>
						<diffuse>
							<texture texture="img_sampler" texcoord="uv" />
						</diffuse>
						<specular>
							<color>1 1 1 1</color>
						</specular>
					</phong>
				</technique>
			</profile_COMMON>
		</effect>
