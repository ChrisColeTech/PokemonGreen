						<param name="INTERPOLATION" type="Name"/>
					</accessor>
				</technique_common>
			</source>
			<sampler id="anim_TailA03_transform_sampler">
				<input semantic="INPUT" source="#anim_TailA03_transform_input"/>
				<input semantic="OUTPUT" source="#anim_TailA03_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_TailA03_transform_interpolation"/>
			</sampler>
			<channel source="#anim_TailA03_transform_sampler" target="TailA03_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>