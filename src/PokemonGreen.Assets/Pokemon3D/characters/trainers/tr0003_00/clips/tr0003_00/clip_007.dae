				<input semantic="OUTPUT" source="#anim_RParts_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_RParts_transform_interpolation"/>
			</sampler>
			<channel source="#anim_RParts_transform_sampler" target="RParts_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>