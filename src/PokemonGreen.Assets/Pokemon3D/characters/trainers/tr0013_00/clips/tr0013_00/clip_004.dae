				</technique_common>
			</source>
			<sampler id="anim_Head_transform_sampler">
				<input semantic="INPUT" source="#anim_Head_transform_input"/>
				<input semantic="OUTPUT" source="#anim_Head_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_Head_transform_interpolation"/>
			</sampler>
			<channel source="#anim_Head_transform_sampler" target="Head_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>