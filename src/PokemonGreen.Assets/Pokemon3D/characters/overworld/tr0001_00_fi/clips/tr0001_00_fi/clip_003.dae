			</source>
			<sampler id="anim_LHairA_transform_sampler">
				<input semantic="INPUT" source="#anim_LHairA_transform_input"/>
				<input semantic="OUTPUT" source="#anim_LHairA_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_LHairA_transform_interpolation"/>
			</sampler>
			<channel source="#anim_LHairA_transform_sampler" target="LHairA_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>