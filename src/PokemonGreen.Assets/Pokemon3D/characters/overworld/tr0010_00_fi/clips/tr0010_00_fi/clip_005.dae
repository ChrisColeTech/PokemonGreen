						<param name="INTERPOLATION" type="Name"/>
					</accessor>
				</technique_common>
			</source>
			<sampler id="anim_RFoot_transform_sampler">
				<input semantic="INPUT" source="#anim_RFoot_transform_input"/>
				<input semantic="OUTPUT" source="#anim_RFoot_transform_output"/>
