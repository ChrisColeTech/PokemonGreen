				<input semantic="INTERPOLATION" source="#anim_RSkirtB_transform_interpolation"/>
			</sampler>
			<channel source="#anim_RSkirtB_transform_sampler" target="RSkirtB_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>