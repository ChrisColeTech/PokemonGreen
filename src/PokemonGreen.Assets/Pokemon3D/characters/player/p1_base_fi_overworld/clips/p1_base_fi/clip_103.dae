					</accessor>
				</technique_common>
			</source>
			<source id="anim_Neck_transform_interpolation">
				<Name_array id="anim_Neck_transform_interpolation_array" count="18">LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR</Name_array>
				<technique_common>
					<accessor source="#anim_Neck_transform_interpolation_array" count="18" stride="1">
						<param name="INTERPOLATION" type="Name"/>
					</accessor>
				</technique_common>
			</source>
			<sampler id="anim_Neck_transform_sampler">
				<input semantic="INPUT" source="#anim_Neck_transform_input"/>
				<input semantic="OUTPUT" source="#anim_Neck_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_Neck_transform_interpolation"/>
			</sampler>
			<channel source="#anim_Neck_transform_sampler" target="Neck_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>