					</accessor>
				</technique_common>
			</source>
			<source id="anim_Head_transform_interpolation">
				<Name_array id="anim_Head_transform_interpolation_array" count="14">LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR</Name_array>
				<technique_common>
					<accessor source="#anim_Head_transform_interpolation_array" count="14" stride="1">
						<param name="INTERPOLATION" type="Name"/>
					</accessor>
				</technique_common>
			</source>
			<sampler id="anim_Head_transform_sampler">
				<input semantic="INPUT" source="#anim_Head_transform_input"/>
				<input semantic="OUTPUT" source="#anim_Head_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_Head_transform_interpolation"/>
			</sampler>
			<channel source="#anim_Head_transform_sampler" target="Head_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>