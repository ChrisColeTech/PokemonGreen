				<input semantic="OUTPUT" source="#anim_Tops_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_Tops_transform_interpolation"/>
			</sampler>
			<channel source="#anim_Tops_transform_sampler" target="Tops_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>