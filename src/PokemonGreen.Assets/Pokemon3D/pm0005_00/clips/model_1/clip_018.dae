				</technique_common>
			</source>
			<source id="anim_RFoot_transform_interpolation">
				<Name_array id="anim_RFoot_transform_interpolation_array" count="6">LINEAR LINEAR LINEAR LINEAR LINEAR LINEAR</Name_array>
				<technique_common>
					<accessor source="#anim_RFoot_transform_interpolation_array" count="6" stride="1">
						<param name="INTERPOLATION" type="Name"/>
					</accessor>
				</technique_common>
			</source>
			<sampler id="anim_RFoot_transform_sampler">
				<input semantic="INPUT" source="#anim_RFoot_transform_input"/>
				<input semantic="OUTPUT" source="#anim_RFoot_transform_output"/>
				<input semantic="INTERPOLATION" source="#anim_RFoot_transform_interpolation"/>
			</sampler>
			<channel source="#anim_RFoot_transform_sampler" target="RFoot_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>