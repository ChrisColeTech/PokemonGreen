				<input semantic="INTERPOLATION" source="#anim_RFoot_transform_interpolation"/>
			</sampler>
			<channel source="#anim_RFoot_transform_sampler" target="RFoot_bone_id/transform"/>
		</animation>
	</library_animations>
</COLLADA>